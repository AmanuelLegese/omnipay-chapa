{
    "name": "amanuellegese/omnipay-chapa",
    "type": "library",
    "description": "Chapa driver for the Omnipay PHP payment processing library",
    "keywords": [
        "chapa",
        "ethiopia",
        "etb",
        "telebirr",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "purchase"
    ],
    "homepage": "https://github.com/AmanuelLegese/omnipay-chapa",
    "license": "MIT",
    "authors": [
        {
            "name": "Amanuel Legese",
            "email": "Amleaz2005@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": { "Omnipay\\Chapa\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Omnipay\\Chapa\\Tests\\": "tests/" }
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "omnipay/common": "^3.5"
    },
    "require-dev": {
        "omnipay/tests": "^4.2",
        "phpunit/phpunit": "^11.0",
        "php-http/mock-client": "^1.6",
        "php-http/guzzle7-adapter": "^1",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs -p --standard=PSR2 src/",
        "fix-style": "phpcbf -p --standard=PSR2 src/"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
